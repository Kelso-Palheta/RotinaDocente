rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // 1. Professores: acesso estrito ao seu próprio UID e subcoleções
    match /professores/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Correções de redação: apenas o professor dono pode ler e escrever diretamente
      match /correcoes/{corrId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Atividades: criação e leitura autenticada pelo professor
    match /atividades/{activityId} {
      allow read: if isAuth();
      allow write: if isAuth() && (
        !exists(/databases/$(database)/documents/atividades/$(activityId)) ||
        resource.data.professorId == request.auth.uid
      );

      match /tokens/{alunoId} {
        allow read, write: if isAuth();
      }
    }

    // 3. Entregas: acessíveis apenas para o professor autenticado (alunos submetem via BFF)
    match /entregas/{entregaId} {
      allow read, write: if isAuth();
    }

    // 4. Base de Alunos e Vínculos: gerenciados exclusivamente por professores autenticados
    match /alunoLogin/{loginKey} {
      allow read, write: if isAuth();

      match /vinculos/{profId} {
        allow read, write: if isAuth() && request.auth.uid == profId;
      }
    }

    // Regra para permitir que o professor limpe/gerencie seus vínculos (Collection Group)
    match /{path=**}/vinculos/{profId} {
      allow read, write: if isAuth() && request.auth.uid == profId;
    }

    // 5. Notas dos Alunos: gerenciadas exclusivamente por professores autenticados (alunos consultam via BFF)
    match /notasAluno/{recordId} {
      allow read, write: if isAuth();
    }

    // 6. Horário Escolar: leitura e escrita pelo próprio professor autenticado (RN-24)
    match /horario_escolar/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 7. Regra padrão Zero-Trust: negar tudo que não for explicitamente autorizado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
