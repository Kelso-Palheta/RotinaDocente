rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // 1. Professores: acesso estrito ao seu próprio UID e subcoleções
    match /professores/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Correções de redação: apenas o professor dono pode ler e escrever diretamente
      match /correcoes/{corrId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Atividade e acessos pertencem ao professor; alunos utilizam somente o BFF.
    function ownsActivity(activityId) {
      return isAuth() && get(/databases/$(database)/documents/atividades/$(activityId)).data.professorId == request.auth.uid;
    }
    match /atividades/{activityId} {
      allow get: if isAuth() && (!exists(/databases/$(database)/documents/atividades/$(activityId)) || resource.data.professorId == request.auth.uid);
      allow list: if isAuth() && resource.data.professorId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.professorId == request.auth.uid;
      allow update: if ownsActivity(activityId) && request.resource.data.professorId == resource.data.professorId;
      allow delete: if ownsActivity(activityId);

      match /tokens/{vinculoId} {
        allow read: if ownsActivity(activityId);
        // getAfter permite atividade + acessos no mesmo lote atômico.
        allow write: if isAuth() && getAfter(/databases/$(database)/documents/atividades/$(activityId)).data.professorId == request.auth.uid;
      }
    }
    match /entregas/{entregaId} {
      allow read: if isAuth() && ((('professorId' in resource.data) && resource.data.professorId == request.auth.uid) || ownsActivity(resource.data.activityId));
      allow create: if isAuth() && ownsActivity(request.resource.data.activityId) && request.resource.data.professorId == request.auth.uid;
      allow update: if ownsActivity(resource.data.activityId) && request.resource.data.activityId == resource.data.activityId;
      allow delete: if ownsActivity(resource.data.activityId);
    }

    // 4. Base de Alunos e Vínculos: gerenciados exclusivamente por professores autenticados
    match /alunoLogin/{loginKey} {
      allow read, write: if isAuth();

      match /vinculos/{profId} {
        allow read, write: if isAuth() && request.auth.uid == profId;
      }
    }

    // Regra para permitir que o professor limpe/gerencie seus vínculos (Collection Group)
    match /{path=**}/vinculos/{profId} {
      allow read, write: if isAuth() && request.auth.uid == profId;
    }

    // 5. Notas dos Alunos: gerenciadas exclusivamente por professores autenticados (alunos consultam via BFF)
    match /notasAluno/{recordId} {
      allow read, write: if isAuth();
    }

    // 6. Horário Escolar: leitura e escrita pelo próprio professor autenticado (RN-24)
    match /horario_escolar/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 7. Regra padrão Zero-Trust: negar tudo que não for explicitamente autorizado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
